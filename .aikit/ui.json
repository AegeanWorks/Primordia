{
  "schema": 1,
  "surfaces": {
    "web": {
      "paths": [
        "primordia/static/**",
        "primordia/web.py"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "python -m unittest discover",
    "snapshot": ""
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300
  }
}